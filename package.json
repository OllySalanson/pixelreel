{
  "name": "pixelreel",
  "version": "0.1.0",
  "description": "Narrated pixel-art explainer videos, made from a short list of scenes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OllySalanson/pixelreel.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "new": "node scripts/new-reel.mjs",
    "voices": "node scripts/voices.mjs",
    "check": "node scripts/check-reel.mjs",
    "page": "node scripts/page.mjs",
    "service": "node service/main.mjs",
    "skill": "node scripts/skill.mjs",
    "site-art": "node scripts/site-art.mjs",
    "video": "node scripts/video.mjs",
    "test": "node --test --test-concurrency=2 \"test/*.test.js\"",
    "lint": "eslint .",
    "bottles": "bottles --service https://pixelreel.pro --gcloud-secret pixelreel-bottle-reader --project pixelreel-515501",
    "bottle-update": "node scripts/bottle-update.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.2.0",
    "message-in-a-bottle": "file:vendor/message-in-a-bottle-0.4.0.tgz"
  }
}
